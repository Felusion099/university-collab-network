{
  "name": "university-collab-platform",
  "private": true,
  "version": "0.1.0",
  "description": "University Collaboration Platform — Campus UI (React 19 + Vite + Tailwind v4) wired to the UCN API (Express + Prisma + PostgreSQL).",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "dev:api": "pnpm --filter @app/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @app/api test",
    "db:migrate": "pnpm --filter @app/api prisma:migrate",
    "db:seed": "pnpm --filter @app/api prisma:seed",
    "db:studio": "pnpm --filter @app/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  }
}
