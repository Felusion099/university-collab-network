# live = real API (requires apps/api running + PostgreSQL); demo = localStorage mock data
VITE_API_MODE="live"
# Base URL of the API (v1 prefix included). "/api/v1" uses the Vite dev
# proxy (same-origin, no CORS). Set a full URL in production, e.g.
# https://api.example.com/api/v1
VITE_API_BASE_URL="/api/v1"
