# apps/api environment variables.
# Kept in sync with ENVIRONMENT.md — do not add a var here (or read one via
# process.env in code) without adding it there first, with its introducing
# phase.

# --- Active as of Phase 1 ---
PORT=4000
NODE_ENV=development

# --- Active as of Phase 2 ---
DATABASE_URL="postgresql://ucn_dev:ucn_dev_pw@localhost:5432/ucn_dev?schema=public"

# --- Active as of Phase 4 ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@example.com
UNIVERSITY_EMAIL_DOMAINS=university.edu
APP_BASE_URL=http://localhost:5173

# --- Documented in ENVIRONMENT.md but NOT YET introduced — do not read these
#     from process.env until the phase listed lands. Left here as a preview
#     so later phases don't have to guess the variable names. ---
# STORAGE_DRIVER=local         # Phase 3 (default: local)
# STORAGE_LOCAL_PATH=          # Phase 3
# CORS_ALLOWED_ORIGINS=        # Phase 3
# RATE_LIMIT_WINDOW_MS=        # Phase 11
# RATE_LIMIT_MAX=              # Phase 11
